# .env.example — Variables de entorno para desarrollo local con Docker
# Copiar este archivo como ".env" y ajustar los valores:
#   cp .env.example .env

# ──── Base de datos ────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_USER=enjambre_user
MYSQL_PASSWORD=enjambre_pass

# ──── Correo (Brevo / Sendinblue) ─────────────────────────────
# Obtener la API Key en: https://app.brevo.com → SMTP & API → API Keys
BREVO_API_KEY=tu_clave_api_aqui
BREVO_EMAIL_FROM=tu_correo@ejemplo.com
